# Which LLM backs the 5 agents: mock | anthropic | openai | gemini | openai-compatible
# "mock" runs fully offline with a scripted TCP-handshake demo (great for judging Wi-Fi).
LLM_PROVIDER=mock

# Optional model override (defaults per provider are in lib/llm/index.ts)
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# For openai-compatible servers (Ollama, Groq, Together, LM Studio, vLLM...)
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_API_KEY=

# Any-topic grounding: searches Wikipedia (no key) and merges results with the trusted repos.
# Off in mock mode. Set to "off" to use only trusted repos + uploads.
WEB_SEARCH=on
# Wikipedia language edition (en, de, fr, ...)
WEB_SEARCH_LANG=en

# Optional fixed timeout per model call, in ms. By default it scales with the output size
# (60 s to 240 s) and is always capped by the route's maxDuration.
LLM_TIMEOUT_MS=

# Optional: raises GitHub rate limits for `npm run ingest`
GITHUB_TOKEN=
